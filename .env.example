# ============================================================
# SERS — Environment Variables
# Copy this to .env and fill in your actual values
# NEVER commit .env to git!
# ============================================================

# ---- NODE ENV ----
NODE_ENV=development
PORT=3000

# ---- DATABASE (PostgreSQL + PostGIS) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sers_db
DB_USER=sers_user
DB_PASSWORD=sers_secret_password
DATABASE_URL=postgresql://sers_user:sers_secret_password@localhost:5432/sers_db

# ---- REDIS ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---- JWT AUTH ----
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRES_IN=30d

# ---- ENCRYPTION (for ABDM tokens) ----
ENCRYPTION_KEY=32_char_encryption_key_here_xxxx

# ---- ML SERVICE ----
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_API_KEY=ml_internal_api_key

# ---- GOOGLE MAPS / OPENSTREETMAP ----
# Leave blank to use OpenStreetMap (free, no key needed)
GOOGLE_MAPS_API_KEY=
# OR use Mapbox (free tier available)
MAPBOX_ACCESS_TOKEN=

# ---- FIREBASE (Push Notifications) ----
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FCM_SERVER_KEY=

# ---- SMS GATEWAY ----
# MSG91 (India) — Get free trial at msg91.com
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SERS
MSG91_TEMPLATE_ID=
# OR Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- GEMINI AI (Admin Dispatch Assistant) ----
GEMINI_API_KEY=

# ---- ABDM SANDBOX ----
# Register at https://sandbox.abdm.gov.in
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api/v3
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
# Set to 'production' when going live
ABDM_ENV=sandbox

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ---- RATE LIMITING ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- MISC ----
LOG_LEVEL=debug
BCRYPT_ROUNDS=12
